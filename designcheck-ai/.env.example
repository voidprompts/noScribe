# === Required for production SEO ===
# Your canonical production URL (no trailing slash).
# Set this in Vercel > Project > Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ============================================================
# Payment providers — paste any of these keys and that method
# instantly switches from demo mode to REAL payments.
# The code lives in:
#   src/app/api/checkout/route.ts         (create session)
#   src/app/api/checkout/verify/route.ts  (verify/capture)
# ============================================================

# --- Stripe (card payments) ---
# Get keys: https://dashboard.stripe.com/apikeys
# Use sk_test_... to test, sk_live_... for real charges.
STRIPE_SECRET_KEY=

# --- PayPal ---
# Get keys: https://developer.paypal.com/dashboard/applications
# PAYPAL_ENV: "sandbox" (default, for testing) or "live"
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# --- GCash via PayMongo (Philippines) ---
# Get keys: https://dashboard.paymongo.com/developers
# Use sk_test_... to test, sk_live_... for real charges.
PAYMONGO_SECRET_KEY=
